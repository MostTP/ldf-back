generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model activation_payments {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  amount       Decimal?  @default(3000) @db.Decimal(12, 2)
  currency     String?   @default("NGN") @db.VarChar(10)
  gateway      String?   @db.VarChar(50)
  gateway_ref  String?   @unique(map: "activation_payments_gateway_ref_unique") @db.VarChar(255)
  status       String?   @default("pending") @db.VarChar(50)
  coupon_used  String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  coupons      coupons?  @relation(fields: [coupon_used], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activation_payments_coupon_used_foreign")
  users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activation_payments_user_id_foreign")
}

model audit_logs {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id         String    @db.Uuid
  action_type      String    @db.VarChar(255)
  target_entity    String    @db.VarChar(255)
  target_id        String?   @db.Uuid
  payload_snapshot Json?
  ip_address       String?   @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_logs_admin_id_foreign")

  @@index([action_type], map: "idx_audit_logs_action_type")
  @@index([admin_id], map: "idx_audit_logs_admin_id")
  @@index([created_at], map: "idx_audit_logs_created_at")
}

model available_balance {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @unique(map: "available_balance_user_id_unique") @db.Uuid
  balance      Decimal?  @default(0) @db.Decimal(12, 2)
  last_updated DateTime? @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "available_balance_user_id_foreign")
}

model capital_pool_ledger {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  description String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

model coupons {
  id                            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                          String                @unique(map: "coupons_code_unique") @db.VarChar(255)
  agent_id                      String                @db.Uuid
  used_by                       String?               @db.Uuid
  used_at                       DateTime?             @db.Timestamptz(6)
  created_at                    DateTime?             @default(now()) @db.Timestamptz(6)
  activation_payments           activation_payments[]
  users_coupons_agent_idTousers users                 @relation("coupons_agent_idTousers", fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "coupons_agent_id_foreign")
  users_coupons_used_byTousers  users?                @relation("coupons_used_byTousers", fields: [used_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "coupons_used_by_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model earnings_ledger {
  id                                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                     String    @db.Uuid
  type                                        String    @db.VarChar(255)
  amount                                      Decimal   @db.Decimal(12, 2)
  source_user_id                              String?   @db.Uuid
  level                                       Int?
  reference_id                                String?   @db.Uuid
  description                                 String?
  created_at                                  DateTime? @default(now()) @db.Timestamptz(6)
  users_earnings_ledger_source_user_idTousers users?    @relation("earnings_ledger_source_user_idTousers", fields: [source_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "earnings_ledger_source_user_id_foreign")
  users_earnings_ledger_user_idTousers        users     @relation("earnings_ledger_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "earnings_ledger_user_id_foreign")

  @@index([created_at], map: "idx_earnings_ledger_created_at")
  @@index([type], map: "idx_earnings_ledger_type")
  @@index([user_id], map: "idx_earnings_ledger_user_id")
}

model global_pool_ledger {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  description String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

model global_pool_memberships {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  enrolled_at    DateTime? @default(now()) @db.Timestamptz(6)
  last_paid_at   DateTime? @db.Timestamptz(6)
  total_received Decimal?  @default(0) @db.Decimal(12, 2)
  users          users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "global_pool_memberships_user_id_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model investments {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  amount         Decimal   @db.Decimal(12, 2)
  lock_end_date  DateTime  @db.Date
  total_roi_paid Decimal?  @default(0) @db.Decimal(12, 2)
  status         String?   @default("active") @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "investments_user_id_foreign")
}

model knex_migrations {
  id             Int       @id @default(autoincrement())
  name           String?   @db.VarChar(255)
  batch          Int?
  migration_time DateTime? @db.Timestamptz(6)
}

model knex_migrations_lock {
  index     Int  @id @default(autoincrement())
  is_locked Int?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model masterclass_modules {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String                 @db.VarChar(255)
  description          String?
  video_url            String?                @db.VarChar(255)
  order_index          Int?                   @default(0)
  status               String?                @default("active") @db.VarChar(50)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  masterclass_progress masterclass_progress[]
}

model masterclass_progress {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String              @db.Uuid
  module_id           String              @db.Uuid
  completion_pct      Int?                @default(0)
  last_activity       DateTime?           @default(now()) @db.Timestamptz(6)
  completed_at        DateTime?           @db.Timestamptz(6)
  masterclass_modules masterclass_modules @relation(fields: [module_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "masterclass_progress_module_id_foreign")
  users               users               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "masterclass_progress_user_id_foreign")

  @@unique([user_id, module_id], map: "masterclass_progress_user_id_module_id_unique")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model matrix_nodes {
  id                                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                              String    @db.Uuid
  sponsor_id                           String    @db.Uuid
  parent_id                            String    @db.Uuid
  position                             Int
  level                                Int
  placement_type                       String    @db.VarChar(255)
  status                               String?   @default("active") @db.VarChar(50)
  created_at                           DateTime? @default(now()) @db.Timestamptz(6)
  users_matrix_nodes_parent_idTousers  users     @relation("matrix_nodes_parent_idTousers", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "matrix_nodes_parent_id_foreign")
  users_matrix_nodes_sponsor_idTousers users     @relation("matrix_nodes_sponsor_idTousers", fields: [sponsor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "matrix_nodes_sponsor_id_foreign")
  users_matrix_nodes_user_idTousers    users     @relation("matrix_nodes_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "matrix_nodes_user_id_foreign")

  @@unique([parent_id, position], map: "matrix_nodes_parent_id_position_unique")
  @@index([level], map: "idx_matrix_nodes_level")
  @@index([parent_id], map: "idx_matrix_nodes_parent_id")
  @@index([sponsor_id], map: "idx_matrix_nodes_sponsor_id")
  @@index([user_id], map: "idx_matrix_nodes_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model member_profiles {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @unique(map: "member_profiles_user_id_unique") @db.Uuid
  bank_name      String?   @db.VarChar(255)
  bank_code      String?   @db.VarChar(255)
  account_number String?   @db.VarChar(255)
  account_name   String?   @db.VarChar(255)
  currency       String?   @default("NGN") @db.VarChar(10)
  kyc_doc_url    String?   @db.VarChar(255)
  kyc_doc_hash   String?   @db.VarChar(255)
  kyc_status     String?   @default("pending") @db.VarChar(50)
  country        String?   @db.VarChar(255)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "member_profiles_user_id_foreign")
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @db.VarChar(255)
  message    String?
  payload    Json?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  title      String?   @db.VarChar(255)
  body       String?
  is_read    Boolean?  @default(false)
  metadata   Json?
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notifications_user_id_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model scheduler_logs {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_type          String    @db.VarChar(255)
  triggered_by      String    @db.VarChar(255)
  admin_id          String?   @db.Uuid
  status            String    @db.VarChar(255)
  total_distributed Decimal?  @db.Decimal(12, 2)
  member_count      Int?
  error_message     String?
  started_at        DateTime? @default(now()) @db.Timestamptz(6)
  completed_at      DateTime? @db.Timestamptz(6)
  users             users?    @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "scheduler_logs_admin_id_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                       String                    @unique(map: "users_email_unique") @db.VarChar(255)
  username                                                    String                    @unique(map: "users_username_unique") @db.VarChar(100)
  password_hash                                               String
  role                                                        String                    @db.VarChar(255)
  is_agent                                                    Boolean?                  @default(false)
  commission_rate                                             Decimal?                  @default(0) @db.Decimal(5, 2)
  status                                                      String?                   @default("active") @db.VarChar(50)
  created_at                                                  DateTime?                 @default(now()) @db.Timestamptz(6)
  last_login                                                  DateTime?                 @db.Timestamptz(6)
  full_name                                                   String?                   @db.VarChar(255)
  phone                                                       String?                   @db.VarChar(20)
  referred_by                                                 String?                   @db.Uuid
  agent_coupon_credits                                        Int                       @default(0)
  activation_coupon                                           String?                   @db.VarChar(64)
  package_type                                                String?                   @default("Silver") @db.VarChar(20)
  is_matrix_qualified                                         Boolean?                  @default(false)
  direct_referral_count                                       Int?                      @default(0)
  cashback_enabled                                            Boolean?                  @default(false)
  cashback_percentage                                         Decimal?                  @default(0) @db.Decimal(5, 2)
  activation_payments                                         activation_payments[]
  audit_logs                                                  audit_logs[]
  available_balance                                           available_balance?
  coupons_coupons_agent_idTousers                             coupons[]                 @relation("coupons_agent_idTousers")
  coupons_coupons_used_byTousers                              coupons[]                 @relation("coupons_used_byTousers")
  earnings_ledger_earnings_ledger_source_user_idTousers       earnings_ledger[]         @relation("earnings_ledger_source_user_idTousers")
  earnings_ledger_earnings_ledger_user_idTousers              earnings_ledger[]         @relation("earnings_ledger_user_idTousers")
  global_pool_memberships                                     global_pool_memberships[]
  investments                                                 investments[]
  masterclass_progress                                        masterclass_progress[]
  matrix_nodes_matrix_nodes_parent_idTousers                  matrix_nodes[]            @relation("matrix_nodes_parent_idTousers")
  matrix_nodes_matrix_nodes_sponsor_idTousers                 matrix_nodes[]            @relation("matrix_nodes_sponsor_idTousers")
  matrix_nodes_matrix_nodes_user_idTousers                    matrix_nodes[]            @relation("matrix_nodes_user_idTousers")
  member_profiles                                             member_profiles?
  notifications                                               notifications[]
  scheduler_logs                                              scheduler_logs[]
  users                                                       users?                    @relation("usersTousers", fields: [referred_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_referred_by_foreign")
  other_users                                                 users[]                   @relation("usersTousers")
  wallets                                                     wallets?
  withdrawal_requests_withdrawal_requests_processed_byTousers withdrawal_requests[]     @relation("withdrawal_requests_processed_byTousers")
  withdrawal_requests_withdrawal_requests_user_idTousers      withdrawal_requests[]     @relation("withdrawal_requests_user_idTousers")

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@index([username], map: "idx_users_username")
}

model webhook_events {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      String    @db.VarChar(255)
  event_id    String?   @db.VarChar(255)
  received_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([received_at(sort: Desc)], map: "idx_webhook_events_received_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model withdrawal_requests {
  id                                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                       String    @db.Uuid
  amount                                        Decimal   @db.Decimal(12, 2)
  currency                                      String    @db.VarChar(10)
  bank_code                                     String    @db.VarChar(255)
  account_number                                String    @db.VarChar(255)
  status                                        String?   @default("pending") @db.VarChar(50)
  reject_reason                                 String?
  gateway_ref                                   String?   @db.VarChar(255)
  processed_by                                  String?   @db.Uuid
  created_at                                    DateTime? @default(now()) @db.Timestamptz(6)
  processed_at                                  DateTime? @db.Timestamptz(6)
  users_withdrawal_requests_processed_byTousers users?    @relation("withdrawal_requests_processed_byTousers", fields: [processed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "withdrawal_requests_processed_by_foreign")
  users_withdrawal_requests_user_idTousers      users     @relation("withdrawal_requests_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "withdrawal_requests_user_id_foreign")

  @@index([status], map: "idx_withdrawal_requests_status")
  @@index([user_id], map: "idx_withdrawal_requests_user_id")
}

model adsense_events {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type String    @db.VarChar(100)
  payload    Json?
  url        String?   @db.VarChar(2048)
  ip_address String?   @db.VarChar(45)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_adsense_events_created_at")
  @@index([event_type], map: "idx_adsense_events_event_type")
}

model wallets {
  user_id          String    @id @db.Uuid
  main_earnings    Decimal?  @default(0) @db.Decimal(12, 2)
  affiliate_income Decimal?  @default(0) @db.Decimal(12, 2)
  matrix_income    Decimal?  @default(0) @db.Decimal(12, 2)
  global_pool      Decimal?  @default(0) @db.Decimal(12, 2)
  lost_earnings    Decimal?  @default(0) @db.Decimal(12, 2)
  detty_december   Decimal?  @default(0) @db.Decimal(12, 2)
  game_points      Int?      @default(0)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wallets_user_id_foreign")
}
