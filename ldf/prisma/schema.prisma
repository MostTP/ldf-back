// Prisma Schema for LDF (Little Drop Fund)
// Configured for Neon PostgreSQL with connection pooling

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon supports connection pooling via ?pgbouncer=true parameter
  // Use direct connection for migrations: remove ?pgbouncer=true
  // Use pooled connection for app: add ?pgbouncer=true
}

model User {
  id                        Int       @id @default(autoincrement())
  firstName                 String
  lastName                  String
  email                     String    @unique
  phone                     String    @unique
  username                  String    @unique
  passwordHash              String
  bankName                  String?
  bankAccount               String?
  
  // Referral/Sponsor system
  sponsorId                 Int?
  sponsor                   User?     @relation("UserSponsors", fields: [sponsorId], references: [id])
  referrals                 User[]    @relation("UserSponsors")
  
  // Activation & Status
  couponCode                String?
  emailVerified             Boolean   @default(false)
  emailVerificationToken    String?
  emailVerificationTokenExpiry DateTime?
  isAgent                   Boolean   @default(false)
  isPremium                 Boolean   @default(false)
  kycVerified               Boolean   @default(false)
  
  // Agent system
  agentCouponCredits        Int       @default(0)
  
  // Terms & Agreements
  termsAccepted             Boolean   @default(false)
  riskDisclosureAccepted    Boolean   @default(false)
  couponAcknowledged        Boolean   @default(false)
  
  // Balance
  balance                   Decimal   @default(0) @db.Decimal(15, 2)
  
  // Relationships
  earnings                  Earning[]
  withdrawals               Withdrawal[]
  investments               Investment[]
  couponsCreated            Coupon[]  @relation("AgentCoupons")
  couponsUsed               Coupon[]  @relation("UsedCoupons")
  
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([email])
  @@index([username])
  @@index([sponsorId])
  @@index([emailVerificationToken])
}

model Earning {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(15, 2)
  type        String   // REFERRAL_BONUS, MATRIX_LEVEL_1-5, GLOBAL_POOL_ROI, PREMIUM_ROI, DETTY_DECEMBER, etc.
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Withdrawal {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(15, 2)
  currency        String    @default("NGN")
  bankName        String?
  bankAccount     String?
  accountName     String?
  status          String    @default("PENDING") // PENDING, APPROVED, PAID, FAILED
  paymentReference String?
  processedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Investment {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(15, 2)
  tier            String    // PREMIUM, CAPITAL_POOL, etc.
  paymentReference String   @unique
  status          String    @default("pending") // pending, completed, failed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentReference])
}

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  agentId     Int
  agent       User      @relation("AgentCoupons", fields: [agentId], references: [id], onDelete: Cascade)
  isUsed      Boolean   @default(false)
  usedBy      Int?
  usedByUser  User?     @relation("UsedCoupons", fields: [usedBy], references: [id])
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([code])
  @@index([agentId])
  @@index([isUsed])
}
